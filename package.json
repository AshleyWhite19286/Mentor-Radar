{
  "name": "mentor-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "data:audit": "node --import tsx scripts/audit.ts",
    "data:seed": "node --import tsx scripts/import-directory.ts",
    "data:directory:three": "python3 scripts/collect.py --per-group 3 && node --import tsx scripts/import-directory.ts --per-group=3",
    "data:directory:all": "python3 scripts/collect.py && node --import tsx scripts/import-directory.ts",
    "data:papers:directory": "python3 scripts/enrich-directory.py",
    "data:papers:official": "python3 scripts/enrich-official-works.py",
    "data:papers:official-profile": "python3 scripts/import-official-representative-works.py",
    "data:abstracts:directory": "python3 scripts/supplement-directory-abstracts.py",
    "data:analyses:directory": "node --import tsx scripts/analyze-directory-abstracts.ts",
    "data:analyses:editorial": "node --import tsx scripts/generate-editorial-analyses.ts",
    "data:introductions": "node --import tsx scripts/refresh-institute-observations.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
