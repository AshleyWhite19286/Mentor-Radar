# Optional academic API key. No model keys are bundled.
SEMANTIC_SCHOLAR_API_KEY=

# Used only by `npm run data:analyses:directory`; never commit a real key.
ANALYSIS_API_KEY=
ANALYSIS_BASE_URL=https://models.sjtu.edu.cn/api/v1
ANALYSIS_MODEL=deepseek-chat
# Runtime model credentials are entered in the browser, only kept in memory.

# Optional HTTPS origin for a public demo. Render uses RENDER_EXTERNAL_URL automatically.
# Set this when using a custom domain or another Node.js hosting service.
RADAR_PUBLIC_ORIGIN=
